{
  "name": "balamandian-onboarding-auth-ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "test": "playwright test",
    "lint": "tsc --noEmit && prettier --check src preview tests *.ts *.json *.html",
    "format": "prettier --write src preview tests *.ts *.json *.html",
    "assets:verify": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
